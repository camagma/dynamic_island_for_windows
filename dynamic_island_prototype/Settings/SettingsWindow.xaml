<Window x:Class="dynamic_island_prototype.Settings.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dynamic Island Settings" Width="480" Height="510" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#151917" Foreground="#F1F3F2">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F3F2"/></Style><Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="4,0,0,0"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Calendar" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Google Calendar > Settings > Integrate calendar >&#10;Secret address in iCal format. Paste the HTTPS link below." TextWrapping="Wrap" Margin="0,10,0,10" Foreground="#ADB5AF"/>
   <Grid>
    <PasswordBox x:Name="CalendarAddress" Height="30" VerticalContentAlignment="Center" Background="#101010" Foreground="#EEEEEE" BorderBrush="#383838" Padding="8,0" PasswordChanged="CalendarAddress_Changed" AutomationProperties.Name="Private calendar iCal URL"/>
    <TextBlock x:Name="CalendarPlaceholder" Text="Paste your private iCal URL" Foreground="#777777" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
   </Grid>
   <TextBlock Text="Stored locally. Keep this private link secret." FontSize="11" Foreground="#ADB5AF" Margin="0,6,0,16"/></StackPanel>
  <TextBlock Grid.Row="1" Text="Weather city" FontSize="19" FontWeight="SemiBold"/>
  <DockPanel Grid.Row="2" Margin="0,10,0,8"><Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search" Click="Search_Click"/>
   <Grid>
    <TextBox x:Name="CityQuery" Height="30" VerticalContentAlignment="Center" TextChanged="CityQuery_Changed" Background="#101010" Foreground="#EEEEEE" CaretBrush="White" BorderBrush="#383838" Padding="8,0" AutomationProperties.Name="Weather city search"/>
    <TextBlock Text="Search city, e.g. Kyiv" Foreground="#777777" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CityQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </DockPanel>
  <ComboBox x:Name="CityResults" Grid.Row="3" Height="30" SelectionChanged="CityResults_Changed"/>
  <TextBlock x:Name="CurrentCity" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#ADB5AF"/>
  <TextBlock x:Name="Message" Grid.Row="5" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#A8E7C5"/>
  <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button Content="Save" Click="Save_Click" IsDefault="True"/></StackPanel>
 </Grid>
</Window>

