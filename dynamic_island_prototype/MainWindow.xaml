<Window x:Class="dynamic_island_prototype.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dynamic Island" Width="432" Height="216" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
 ShowActivated="False" Focusable="False" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EFEFEF"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style x:Key="HeaderButton" TargetType="Button">
   <Setter Property="Focusable" Value="False"/><Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/>
   <Setter Property="Foreground" Value="#909090"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="Surface" Property="Background" Value="#202020"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Border x:Name="Pill" Width="288" Height="52" CornerRadius="0,0,26,26" Background="#080808"
   Opacity="0" Visibility="Hidden" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True">
   <Border.RenderTransform><TranslateTransform x:Name="RevealOffset" Y="-16"/></Border.RenderTransform>
   <Border.Effect><DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.28"/></Border.Effect>
   <Border.ContextMenu><ContextMenu><MenuItem Header="Settings..." Click="Settings_Click"/><Separator/><MenuItem Header="Exit Dynamic Island" Click="Exit_Click"/></ContextMenu></Border.ContextMenu>
   <Grid>
    <ContentControl x:Name="Compact" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" IsTabStop="False"/>
    <Grid x:Name="Expanded" Width="384" Height="176" Opacity="0" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top">
     <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="140"/></Grid.RowDefinitions>
     <Grid Margin="18,4,16,0">
      <ListBox x:Name="WidgetTabs" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="WidgetTabs_SelectionChanged"
       Background="Transparent" BorderThickness="0" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
       <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="WidgetTab_MouseDown"/>
        <Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="#707070"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Grid Width="26" Height="28" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/><Border x:Name="Indicator" Height="2" Width="12" CornerRadius="1" Background="White" VerticalAlignment="Bottom" Opacity="0"/></Grid>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D0D0D0"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="Indicator" Property="Opacity" Value="1"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" ToolTip="{Binding Id}" AutomationProperties.Name="{Binding Id}">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE8A5;"/>
          <Style.Triggers><DataTrigger Binding="{Binding Id}" Value="calendar"><Setter Property="Text" Value="&#xE787;"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="weather"><Setter Property="Text" Value="&#xE706;"/></DataTrigger></Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Button Style="{StaticResource HeaderButton}" HorizontalAlignment="Right" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings"/>
     </Grid>
     <ContentControl x:Name="WidgetContent" Grid.Row="1" IsTabStop="False"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
