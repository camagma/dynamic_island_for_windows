<UserControl x:Class="dynamic_island_prototype.Widgets.MusicCompactView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="52">
 <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
  <Border Background="#202020" CornerRadius="8" Width="28" Height="28" ClipToBounds="True">
   <Grid><TextBlock Text="&#x266B;" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid>
  </Border>
  <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12"/>
  <TextBlock Grid.Column="2" Text="&#x266B;" Foreground="#CCCCCC" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="19"/>
 </Grid>
</UserControl>

