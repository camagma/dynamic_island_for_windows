<UserControl x:Class="dynamic_island_prototype.Widgets.MusicExpandedView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="384" Height="140">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
   <Setter Property="Focusable" Value="False"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#242424"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.25"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="20,4,22,20"><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Width="96" Height="112" HorizontalAlignment="Left">
   <Grid.Clip><RectangleGeometry Rect="0,0,96,112" RadiusX="13" RadiusY="13"/></Grid.Clip>
   <Border Background="#1B1B1B"/><TextBlock Text="&#x266B;" FontSize="32" Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
  </Grid>
  <Grid Grid.Column="1" Margin="7,4,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Artist}" Foreground="#999999" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Status}" Foreground="#626262" FontSize="8" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-5,0,0,0">
    <Button Content="&#xE892;" Command="{Binding Previous}" IsEnabled="{Binding CanPrevious}" ToolTip="Previous track" AutomationProperties.Name="Previous track"/>
    <Button Content="{Binding PlayGlyph}" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}" ToolTip="Play / pause" AutomationProperties.Name="Play or pause" Margin="5,0"/>
    <Button Content="&#xE893;" Command="{Binding Next}" IsEnabled="{Binding CanNext}" ToolTip="Next track" AutomationProperties.Name="Next track"/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
