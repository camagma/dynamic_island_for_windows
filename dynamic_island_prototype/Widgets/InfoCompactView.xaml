<UserControl x:Class="dynamic_island_prototype.Widgets.InfoCompactView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="52">
 <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Text="{Binding Icon}" Foreground="#CCCCCC" FontFamily="Segoe UI Symbol" FontSize="23" VerticalAlignment="Center"/>
  <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
 </Grid>
</UserControl>

